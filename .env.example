# ───────────────────────── Agent Hub (Python) ─────────────────────────
# Comando executado pelo worker. O prompt da tarefa fica em AGENT_TASK_PROMPT.
# Exemplo Claude Code no Windows (o worker executa via shell): claude -p "%AGENT_TASK_PROMPT%"
AGENT_HUB_COMMAND=
AGENT_HUB_HOST=127.0.0.1
AGENT_HUB_PORT=8787
AGENT_HUB_DB=.agent-hub/state.db

# ───────────────────────── Clipes (Next.js) ─────────────────────────

# Supabase — públicas (seguras no browser)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key

# Supabase — secreta (server-only; cotas atômicas, jobs, webhooks)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Twitch Helix — App Access Token (client credentials; server-only)
# Crie o app em https://dev.twitch.tv/console (OAuth Redirect URL: http://localhost:3000)
TWITCH_CLIENT_ID=seu_client_id
TWITCH_CLIENT_SECRET=seu_client_secret

# Notificações (Fase 3)
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=

# Pagamentos — AbacatePay (Fase 3)
ABACATEPAY_DEV_KEY=
ABACATEPAY_WEBHOOK=
