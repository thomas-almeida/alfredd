# ───────────────────────── Agent Hub (Python) ─────────────────────────
# Comando executado pelo worker. O prompt da tarefa fica em AGENT_TASK_PROMPT.
# Exemplo Claude Code no Windows (o worker executa via shell): claude -p "%AGENT_TASK_PROMPT%"
AGENT_HUB_COMMAND=
AGENT_HUB_HOST=127.0.0.1
AGENT_HUB_PORT=8787
AGENT_HUB_DB=.agent-hub/state.db

# ───────────────────────── Clipes (Next.js) ─────────────────────────

# Supabase — públicas (seguras no browser)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key

# Supabase — secreta (server-only; cotas atômicas, jobs, webhooks)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Twitch Helix — App Access Token (client credentials; server-only)
# Crie o app em https://dev.twitch.tv/console (OAuth Redirect URL: http://localhost:3000)
TWITCH_CLIENT_ID=seu_client_id
TWITCH_CLIENT_SECRET=seu_client_secret

# Notificações (Fase 3)
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=

# Pagamentos — AbacatePay (Fase 3)
ABACATEPAY_DEV_KEY=
ABACATEPAY_WEBHOOK=

# Transcrição e IA de destaques
# Whisper: groq (padrão, mais barato) ou openai. TRANSCRIBE_API_KEY sobrepõe a chave do preset.
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TRANSCRIBE_PROVIDER=groq
OPENAI_API_KEY=
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_MODEL=
# LLM compatível com OpenAI (padrão OpenRouter) para sugerir destaques.
OPENROUTER_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# Binários usados para baixar e cortar áudio (não existem na Vercel serverless).
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
# Alternativa quando yt-dlp foi instalado com pip: python -m yt_dlp
# PYTHON_PATH=python
# YT_INNERTUBE_CLIENT=ANDROID
# YT_INNERTUBE_CLIENT_VERSION=20.10.38
